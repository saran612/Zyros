{
  "build": {
    "distDir": "../ui/dist",
    "devPath": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "package": {
    "productName": "zyros",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false
    },
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "copyright": "",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.zyros.assistant",
      "longDescription": "",
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": "",
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 200,
        "resizable": false,
        "title": "Zyros Widget",
        "width": 300,
        "label": "widget",
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false
      },
      {
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "Zyros Terminal",
        "width": 800,
        "label": "terminal",
        "alwaysOnTop": false,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ]
  }
}
